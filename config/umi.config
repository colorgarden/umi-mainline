# umi.config — 小米10 主线 bring-up 内核配置片段
#
# 用法（在 WSL 里，树根目录）：
#   make ARCH=arm64 CROSS_COMPILE=aarch64-none-elf- defconfig
#   scripts/kconfig/merge_config.sh -m .config config/umi.config
#   make ARCH=arm64 CROSS_COMPILE=aarch64-none-elf- olddefconfig
#
# 设计原则：
#   1) 无 UART 时必须能看到东西 → simpledrm + fbcon 把 log 打到屏幕
#   2) 关掉一切会「抢屏」或「早期 hang」的东西 → mdss/DRM_MSM 不编（见文末）
#   3) cmdline 由内核内置并强制生效 → 不受 boot.img/ABL 影响，少一个变量
#   4) KASLR 关掉 → 地址固定，方便早期崩溃定位

# ------------------------------------------------------------------ SoC 基础
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_SM8250=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_RPMPD=y
CONFIG_QCOM_GDSC=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_TSENS=y
CONFIG_ARM_SMMU=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_QCOM_ICC_BWMON=y
CONFIG_PM_DEVFREQ=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_QCOM_CPR=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_PSCI_FW=y

# ------------------------------------------------------------------ 控制台
# ttyMSM0 => uart12 (0xa90000) => downstream qupv3_se12_2uart
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y

# ------------------------------------------------------------------ 屏幕上的 console
# 走 DRM 那条路（simpledrm 接管 ABL 留下的 cont-splash）。
# 为什么是它而不是更朴素的 fbdev simplefb：
#   **只有 DRM 驱动能挂 drm_panic** —— panic 时把日志直接画到屏幕上（还能编成二维码）。
#   simpledrm 实现了 get_scanout_buffer（drivers/gpu/drm/tiny/simpledrm.c），
#   所以不需要面板驱动也能有 panic 屏。
# 想换成最朴素的 simplefb：scripts/set-console-path.sh simplefb
#   （注意 FB_SIMPLE 的 Kconfig 里有 "depends on !DRM_SIMPLEDRM"，两者天生互斥）
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONT_8x16=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
# CONFIG_FB_SIMPLE is not set

# ------------------------------------------------------------------ 显示（mdss / DPU / DSI / 7nm PHY）
# 2026-10 起打开 DRM_MSM。以前必须关掉是因为「没有面板驱动时 mdss 会接管 cont-splash，
# 然后因为没有 connector 输出全黑，把 simpledrm 画上去的 log 一起抹掉」——
# 现在这条理由不成立了：
#   1) simpledrm 是 firmware fb，fbcon 一旦挂上就不让位，第二个 DRM 设备的 fbdev
#      不会抢走 console；
#   2) 更关键的是面板节点在 DTS 里可以先保持 status = "disabled"，
#      没有 connector 就不会做任何 modeset，屏幕上的 log 完全不受影响。
#
# ★ 第一次带 mdss 启动时，面板节点是 disabled，所以只验证
#   mdss(display-subsystem) / DPU / DSI ctrl / 7nm PHY 能不能 probe，
#   一根字节都不会发到屏上。确认之后再翻 sm8250-xiaomi-umi.dts 里的 include。
# ★★ 坑（2026-10-24 实测，值得记住）：
#    drivers/gpu/drm/msm/Kconfig 里有这么几行
#        depends on QCOM_AOSS_QMP  || QCOM_AOSS_QMP=n
#        depends on QCOM_OCMEM     || QCOM_OCMEM=n
#        depends on QCOM_LLCC      || QCOM_LLCC=n
#        depends on QCOM_COMMAND_DB|| QCOM_COMMAND_DB=n
#    这是「要么编进去、要么彻底不存在，但不许是模块」的写法。
#    只要其中任何一个 = m，整个表达式就求值成 m，于是 **CONFIG_DRM_MSM=y 被
#    悄悄降级成 =m**，而 build.sh 的 check_y 只会报 DRM_MSM=m，看不出是谁干的。
#    arm64 defconfig 里 CONFIG_QCOM_OCMEM 默认就是 m，就是它。
#    （SM8250 没有 OCMEM 节点，直接关掉最省事；AOSS_QMP/LLCC/COMMAND_DB 都已经是 y。）
# CONFIG_QCOM_OCMEM is not set
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
# DP（DisplayPort over USB-C）和这块屏无关，先不开，少一条可能出错的链路
# CONFIG_DRM_MSM_DP is not set
# 面板驱动（patches/panel-xiaomi-umi.c，build.sh 会挂进 drivers/gpu/drm/panel/）
CONFIG_DRM_PANEL_XIAOMI_UMI=y

# ------------------------------------------------------------------ 触摸
# ST FTS（i2c13 / 0x49），驱动在 patches/fts-umi.c。
#   I2C_QCOM_GENI / QCOM_GPI_DMA 在 arm64 defconfig 里是 =m，initramfs 里没有
#   模块加载器，必须编进内核，否则 i2c13 根本 probe 不起来。
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
# CONFIG_TOUCHSCREEN_FTS_UMI is not set
# 触摸走 bit-banged I2C（QUP1 SE5 是 DMA-only，而主线 GPI DMA 在这块板上
# EV ALLOCATE 超时，详见 dts/sm8250-xiaomi-umi-touch.dtsi 的说明）。

# ------------------------------------------------------------------ panic 屏（drm_panic）
# panic 时不管 console 有没有挂，直接把日志画进扫描缓冲；qr_code 那档还会把
# 压缩后的日志编成一个二维码 —— 手机扫一下就能把整段 log 拿走，不用拍照抄字。
# 这一套是 MT6895-Mainline 项目在用的做法（见 REFERENCE-MT6895.md 3.1）。
#   DRM_PANIC_SCREEN 可以在运行时改：
#     cmdline  drm.panic_screen=kmsg      （画日志文本）
#     cmdline  drm.panic_screen=user      （只画一句"请重启"）
#     cmdline  drm.panic_screen=qr_code   （二维码，默认）
# 二维码里的内容用 tools/decode-panic-qr.py 还原成日志。
CONFIG_DRM_PANIC=y
# debugfs 里能手动触发 panic 屏（不用真崩就能先验证扫不扫得出来）
CONFIG_DRM_PANIC_DEBUG=y
# 1080x2340 这种屏用大一点的字体（drm_panic 的 HiDPI 支持靠它）。
# 注意 FONT_TER16x32 在 Kconfig 里带 "depends on !SPARC && FONTS"，
# 不打开 CONFIG_FONTS（字体选择菜单）这个选项根本不可选 —— 会被静默丢掉。
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
# 想连 console 也用大字（67 列 × 73 行，更好认但长行会折行）：
#   在 CONFIG_CMDLINE 里加 fbcon=font:TER16x32
# 现在保持默认的 8x16（135 列 × 146 行，不折行、信息量最大）
CONFIG_DRM_PANIC_SCREEN="qr_code"
CONFIG_DRM_PANIC_SCREEN_QR_CODE=y
# 留空 = 二维码里直接放未压缩的日志文本（随便什么扫码 App 都能看）；
# 填了 = 放 URL + zlib 压缩后的日志（能装 3 倍的内容，但要解码器还原）
CONFIG_DRM_PANIC_SCREEN_QR_CODE_URL="https://umi.local/panic"
CONFIG_DRM_PANIC_SCREEN_QR_VERSION=40
# 二维码生成器是 Rust 写的（drivers/gpu/drm/drm_panic_qr.rs）—— 内核里第一个 Rust 组件。
# 没有 Rust 工具链时这些会被静默关掉，所以 build.sh 里专门检查了。
CONFIG_RUST=y

# ------------------------------------------------------------------ 存储
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y

# ------------------------------------------------------------------ USB（gadget 备份通道）
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_QCOM_PMIC=y
CONFIG_REGULATOR_QCOM_USB_VBUS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_GADGETFS=y

# ------------------------------------------------------------------ 供电 / 输入
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_POWER_RESET_MSM=y

# ------------------------------------------------------------------ 崩溃现场
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
# 内核 log ring buffer 默认只有 128 KB（LOG_BUF_SHIFT=17），
# 开机 log 一多就把早期内容冲掉了，等 panic 时 kmsg_dump 已经捞不到开头。
# 放大到 2 MB，正好和下面 dump 的上限对齐。
CONFIG_LOG_BUF_SHIFT=21
# 注意：PSTORE_DEFAULT_KMSG_BYTES 在 Kconfig 里带 "if EXPERT"，EXPERT 不开时
# 这个符号根本没有提示符 → olddefconfig 会把它**打回默认 10240（10 KB）**。
# 也就是说 pstore 每次只会快照 10 KB 的日志，panic 现场基本没用。
# 正确做法是在 cmdline 上传 pstore.kmsg_bytes（module_param，见 CONFIG_CMDLINE）。
# CONFIG_PSTORE_DEFAULT_KMSG_BYTES=2097152   ← 这样写没用，别踩

# pstore/blk：panic 时把 log 直接写进一个裸分区（不需要用户态参与）。
# 默认「待机」—— 只有 cmdline 里给了 pstore_blk.blkdev=... 才会启用，
# 所以编进来是安全的。要启用见 scripts/enable-pstore-blk.sh 和 LOG-EXTRACTION.md。
#   best_effort=1 是必须的：UFS 没有 panic_write，只能走普通（可睡眠）I/O
CONFIG_PSTORE_BLK=y
CONFIG_PSTORE_BLK_BLKDEV=""
CONFIG_PSTORE_BLK_KMSG_SIZE=1024
CONFIG_PSTORE_BLK_MAX_REASON=4
CONFIG_PSTORE_ZONE=y

# ------------------------------------------------------------------ 把 log 拿出来的通道
# loop + vfat：initramfs 里现做一个 FAT 镜像，用 USB 大容量存储（U盘模式）挂给电脑，
# 这样 PC 上直接出现一个盘符，里面是 dmesg.txt / pstore.txt —— 不需要串口驱动、不需要终端软件
CONFIG_BLK_DEV_LOOP=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_FAT_FS=y

# ------------------------------------------------------------------ 把「静默卡死」变成「能读的崩溃」
# 这三个是给「屏幕全黑、什么都不知道」准备的保险：
#   QCOM_WDT   ：高通 ABL 跳转前会把 APSS 看门狗打开，主线默认把它编成模块(=m)
#                根本不会被加载 → 内核还在初始化就被看门狗复位 → 表现就是
#                「黑几秒又回到 fastboot」，和 ABL 拒绝镜像长得一模一样。
#                编进内核 + WATCHDOG_HANDLE_BOOT_ENABLED=y（默认）后，内核会
#                接手继续喂狗，卡死就真的是卡死，不会变成复位。
#   HUNG_TASK  ：驱动 probe 卡在 D 状态超过 60 秒 → 直接 panic，
#                panic 会把整个 ring buffer dump 进 ramoops（下次开机就能读）。
#   SOFTLOCKUP ：驱动 probe 里死循环不调度 → 同样 panic + dump。
CONFIG_QCOM_WDT=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=60
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y

# ------------------------------------------------------------------ 早期调试
# KASLR 关掉：早期崩溃时地址可复现，patched head.S 的标记也能算准
CONFIG_RANDOMIZE_BASE=n
CONFIG_DEBUG_INFO_NONE=y
# 交叉编译器/新 clang 的告警不当作错误，否则任何小 warning 都会让编译在半夜挂掉
CONFIG_WERROR=n
CONFIG_LOCALVERSION="-umi"
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x1
CONFIG_PANIC_TIMEOUT=0
CONFIG_PANIC_ON_OOPS=y

# 注意：arm64 **没有** CONFIG_EARLY_PRINTK 这个符号（只有 hexagon / powerpc 有）。
# 以前这里写了一行 CONFIG_EARLY_PRINTK=y，被 Kconfig 静默丢弃 → out/config-effective
# 里根本不存在这个符号。arm64 上真正决定 earlycon 的是：
#     CONFIG_SERIAL_EARLYCON=y                       （串口 earlycon 框架）
#     CONFIG_SERIAL_QCOM_GENI_CONSOLE=y              （ttyMSM0 的控制台实现）
#     drivers/tty/serial/qcom_geni_serial.c 里的
#     OF_EARLYCON_DECLARE(qcom_geni, "qcom,geni-debug-uart", ...)
# 三者都不受 EARLY_PRINTK 影响，所以删掉这一行不会丢功能。

# ------------------------------------------------------------------ 页表尺寸（保守值）
# arm64 Kconfig 的默认值是 52-bit VA（5 级页表 + LPA2 + 52-bit PA）。这套东西全都要靠
# 运行时探测 ID_AA64MMFR0/MMFR2 再回退，在「黑屏 + 没有 UART」的盲调阶段等于给自己
# 多加三个不能观测的变量：Kryo 585（Cortex-A77）到底报不报 LVA / LPA2，回退路径有没有
# 踩到这个 SoC 的怪癖，全都无法从屏幕上看出来。
# 主线其它 SM8250 机型能跑不代表它在 52-bit 路径上跑 —— 它们大多数也没验证过。
# bring-up 阶段固定成 48-bit：三级页表、普通 4K 页，最保守也最常见。
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_ARM64_VA_BITS_52 is not set

# ------------------------------------------------------------------ 内核内置 cmdline（强制生效）
# console=tty0 让 log 出现在屏幕上（这是没有 UART 时唯一可靠的反馈）
# keep_bootcon 保证 boot console 不会被后来的 console 顶掉
# pd_ignore_unused / clk_ignore_unused 保护 ABL 已经打开、主线还不会管的电源域与时钟
# printk.always_kmsg_dump=1：连「正常重启」也把完整 log dump 进 ramoops，
#   这样上一次开机的日志一定能在下一次开机时从 /sys/fs/pstore 读回来
#   （下游的 androidboot cmdline 里也有这一条，是同一个套路）
# pstore.kmsg_bytes=2097152：pstore 每次快照的日志上限。
#   默认只有 10240 字节（10 KB），panic 现场基本等于没有 —— 必须显式放大。
# 注：loglevel=8 已经等于「全都打印」，不需要再写 ignore_loglevel
CONFIG_CMDLINE="console=ttyMSM0,115200n8 console=tty0 loglevel=8 keep_bootcon earlycon pd_ignore_unused clk_ignore_unused regulator_ignore_unused arm-smmu.disable_bypass=0 printk.always_kmsg_dump=1 pstore.kmsg_bytes=2097152"
CONFIG_CMDLINE_FORCE=y

# ------------------------------------------------------------------ 模块
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# 第一阶段调试期间不压缩模块，省点事。
# 注意：符号名是 choice 形式的 CONFIG_MODULE_COMPRESS，不是 CONFIG_MODULE_COMPRESS_NONE
# （后者只在 choice 里选 «none» 时才出现，写 =y 会被静默丢弃）。实测 out/config-effective
# 里 CONFIG_MODULE_COMPRESS 本来就是 not set，等价于不压缩，所以这行只是把状态写明白。
# CONFIG_MODULE_COMPRESS is not set

# ==================================================================
# bring-up 阶段「降低盲调变量」的保守值
# ==================================================================
# 原则：凡是「要探测硬件能力再决定走哪条路」或「要在 probe 里读写没被主线验证过
# 的寄存器」的子系统，在第一次能上机之前一律关掉。这一层东西开着的唯一好处是省电/
# 省电/性能，而它一旦出错，症状和我们正在排查的「黑屏几秒回 fastboot」完全一样。
# 等内核确认能启动（USB 能枚举 / 屏幕出字）之后，用 config/umi-later.config
# 逐条打开，一次只开一组，出问题就知道是谁。
#
# 1) cpuidle：kona 的 PSCI idle 状态要和设备 EL3 里固件的实现完全对上。
#    对不上时 CPU 睡下去可能不回来 —— 表现就是「跑到某个点之后彻底不动」，
#    而且这时 console 往往还没起来。
#
#    真正要关的是 ARM_PSCI_CPUIDLE（arm64 上用 DT 时唯一会注册的 cpuidle 驱动）。
#    它关掉之后，即使 CPU_IDLE=y，也没有任何 driver 会被注册 →
#    cpuidle core 走 default_idle_call() → 直接 WFI，不碰 PSCI power-collapse。
#
#    ★★ 2026-10-23 实测纠正：**这个不能关！**
#    关掉它之后整条电源/时钟链全断，实测日志：
#      platform 18200000.rsc: deferred probe pending:
#          wait for supplier /psci/power-domain-cpu-cluster0
#    apps_rsc 的 power-domains = <&CLUSTER_PD> 指向 /psci 下的 PSCI 电源域，
#    而那个提供者就在 drivers/cpuidle/cpuidle-psci-domain.c，
#    由 CONFIG_ARM_PSCI_CPUIDLE_DOMAIN 门控（depends on ARM_PSCI_CPUIDLE）。
#    关掉之后 rsc probe 不了 -> rpmhcc/rpmhpd 出不来 -> GCC 没时钟 ->
#    UFS / USB / iommu / interconnect 全部 deferred -> dwc3 is not up。
#
#    注意 CONFIG_CPU_IDLE 本身也是关不掉的（drivers/acpi/Kconfig 的
#    ACPI_PROCESSOR 会 select 它，arm64 defconfig 里 ACPI=y）。
CONFIG_ARM_PSCI_CPUIDLE=y
#
# 2) SMMU bypass：arm-smmu 从 5.x 起默认「不给未绑定的 stream 放行」，
#    也就是任何没有 iommus 属性的设备一做 DMA 就会被 abort。
#    sm8250.dtsi 里该写的 iommus 都写了，但 umi 的 DT 是拼出来的，
#    漏一个就是「UFS/USB 探不到」。bring-up 阶段先放行，能跑之后再收紧。
# CONFIG_ARM_SMMU_DISABLE_BYPASS_BY_DEFAULT is not set
# 注意（7.x）：这一项现在 default y，而且只有 CONFIG_EXPERT=y 时才可见，
# 不开 EXPERT 上面这行会被 olddefconfig 改回 y（构建校验会报 FAIL）。
# 等效做法是在 CONFIG_CMDLINE 里带 arm-smmu.disable_bypass=0 —— 内核文档也把
# 命令行参数列为「不想在编译期关掉」时的推荐做法，已加到下面的 CMDLINE 行。
#
# 3) CPR / cpufreq-hw：会主动改写 CPU 电压/频率表。写错了就是随机死机或直接挂住。
#    关掉之后 CPU 保持 ABL 设好的频率和电压，一样能启动。
# CONFIG_QCOM_CPR is not set
# CONFIG_ARM_QCOM_CPUFREQ_HW is not set
# CONFIG_ARM_QCOM_CPUFREQ_NVMEM is not set

# ------------------------------------------------------------------ 一定要留下的
# Cortex-A77 r0/r1 的 1508412（TLBI 之后可能读到脏数据）在 kona 上必然要开。
# 它默认就是 y，这里显式写一遍防止哪天被别的片段关掉。
CONFIG_ARM64_ERRATUM_1508412=y


# Mainline reference implementation: sm7150-mainline fts521 (plain i2c_driver)
# plus the umi-i2c bit-bang adapter. Mutually exclusive with fts-umi
# (they claim the same GPIOs), so TOUCHSCREEN_FTS_UMI is disabled below.
CONFIG_I2C_UMI_BITBANG=y
CONFIG_TOUCHSCREEN_ST_FTS_V521=y

# pwrseq 必须内建：pcie-qcom 是 =y，要在 host_init 里提前调 pwrseq_power_on()
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y


# ------------------------------------------------------------------ wireless: crypto for iwd
# iwd checks these at startup and exits if any is missing (seen: status=1):
#     CONFIG_KEY_DH_OPERATIONS / CRYPTO_{DES,CBC,CMAC,MD5} / CRYPTO_USER_API*
# They default to =m and the rootfs has no crypto modules installed, so build
# them in.  (wpa_supplicant uses its own openssl and does not need these; iwd
# goes through AF_ALG / keyctl.)
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_DH=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_CRYPTO_USER_API_RNG=y
# ---- 电量计 / 充电（PM8150B fg + SMB5 + TI bq25970，见 docs/BATTERY.md）----
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_QCOM_FG=y
CONFIG_CHARGER_QCOM_SMB5=y
CONFIG_CHARGER_BQ25970=y
# pm8150b_charger 要 IIO 通道 usb_in_v_div_16 / usb_in_i_uv
CONFIG_QCOM_SPMI_ADC5=y
